# Local development. Copy to .env; never commit real credentials.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_PRODUCTION=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional integrations.
TELEGRAM_BOT_TOKEN=
TELEPHONY_WEBHOOK_TOKEN=

# Railway: set variables in the service, not in this file.
# DJANGO_PRODUCTION=true
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=crm-production-1469.up.railway.app
# Use PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD references to Railway Postgres.
# Do not also set local POSTGRES_* values: they take precedence over PG*.
# CRM_BOOTSTRAP_PASSWORD creates admin only when the users table is empty.
# Remove it from Railway after the first successful deployment.
# WEB_CONCURRENCY=2
# PORT is supplied by Railway.
